# Firebase web-app configuration. Copy to .env.local to activate real accounts.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Solo para pruebas locales. Dejar vacío para usar Firebase en internet.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=

# Imágenes y videos para el proyecto escolar, sin Firebase Storage ni Blaze.
EXPO_PUBLIC_MEDIA_PROVIDER=cloudinary
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# No colocar API Secret de Cloudinary en la app.
