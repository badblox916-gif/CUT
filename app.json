{
  "expo": {
    "name": "CUT",
    "slug": "cut",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "cut",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/brand/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#141716",
        "foregroundImage": "./assets/brand/adaptive.png",
        "monochromeImage": "./assets/brand/monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#141716",
          "image": "./assets/brand/adaptive.png",
          "imageWidth": 180
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "CUT accede a las fotos y videos que eliges para crear tus cortes.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
