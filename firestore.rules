rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/profiles/$(request.auth.uid)); }
    function cloudMedia(url) {
      return url is string && url.size() <= 2048
        && (url == '' || url.matches('https://firebasestorage.googleapis.com/.*')
          || url.matches('https://res[.]cloudinary[.]com/[a-zA-Z0-9_-]+/(image|video)/upload/.*')
          || url.matches('http://(127[.]0[.]0[.]1|localhost):9199/.*'));
    }
    match /profiles/{uid} {
      allow read: if signedIn();
      function validProfile() {
        let p = request.resource.data;
        return p.keys().hasAll(['name', 'handle', 'bio', 'avatarUri', 'coverUri', 'createdAt', 'updatedAt'])
          && p.keys().hasOnly(['name', 'handle', 'bio', 'avatarUri', 'coverUri', 'createdAt', 'updatedAt'])
          && p.name is string && p.name.size() > 0 && p.name.size() <= 40
          && p.handle is string && p.handle.matches('[a-z0-9_.]{3,24}')
          && p.bio is string && p.bio.size() <= 180
          && cloudMedia(p.avatarUri) && cloudMedia(p.coverUri)
          && p.updatedAt == request.time
          && getAfter(/databases/$(database)/documents/handles/$(p.handle)).data.userId == uid;
      }
      allow create: if owner(uid) && validProfile() && request.resource.data.createdAt == request.time;
      allow update: if owner(uid) && validProfile() && request.resource.data.createdAt == resource.data.createdAt;
    }
    match /handles/{handle} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['userId'])
        && request.resource.data.userId == request.auth.uid
        && (!exists(/databases/$(database)/documents/handles/$(handle)) || resource.data.userId == request.auth.uid)
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.handle == handle;
      allow delete: if owner(resource.data.userId)
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.handle != handle;
    }
    match /posts/{postId} {
      allow read: if signedIn();
      function validPoll(p) {
        return p == null || (p is map && p.keys().hasOnly(['options']) && p.options is list && p.options.size() == 2
          && p.options[0] is string && p.options[1] is string
          && p.options[0].size() > 0 && p.options[0].size() <= 80
          && p.options[1].size() > 0 && p.options[1].size() <= 80
          && p.options[0].lower() != p.options[1].lower());
      }
      function validRepost() {
        let p = request.resource.data;
        let original = /databases/$(database)/documents/posts/$(p.originalPostId);
        let reaction = /databases/$(database)/documents/reactions/$(p.originalPostId + '_' + request.auth.uid);
        return hasProfile() && p.creatorId == request.auth.uid
          && p.keys().hasAll(['creatorId', 'originalPostId', 'text', 'tag', 'imageUri', 'videoUri', 'reel', 'poll', 'createdAt'])
          && p.keys().hasOnly(['creatorId', 'originalPostId', 'text', 'tag', 'imageUri', 'videoUri', 'reel', 'poll', 'createdAt'])
          && p.originalPostId is string && p.originalPostId.matches('[a-zA-Z0-9_-]{1,128}')
          && postId == 'repost_' + p.originalPostId + '_' + request.auth.uid
          && p.text == '' && p.tag == '' && p.imageUri == '' && p.videoUri == '' && p.reel == false && p.poll == null
          && p.createdAt == request.time && exists(original)
          && !('originalPostId' in get(original).data)
          && getAfter(reaction).data.reposted == true
          && getAfter(reaction).data.userId == request.auth.uid;
      }
      allow create: if signedIn() && validRepost();
      allow create: if hasProfile() && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.keys().hasAll(['creatorId', 'text', 'tag', 'imageUri', 'videoUri', 'reel', 'poll', 'createdAt'])
        && request.resource.data.keys().hasOnly(['creatorId', 'text', 'tag', 'imageUri', 'videoUri', 'reel', 'poll', 'createdAt'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && request.resource.data.tag is string && request.resource.data.tag.size() <= 500
        && cloudMedia(request.resource.data.imageUri) && cloudMedia(request.resource.data.videoUri)
        && (request.resource.data.text.size() > 0 || request.resource.data.imageUri != '' || request.resource.data.videoUri != '')
        && request.resource.data.reel is bool
        && (!request.resource.data.reel || request.resource.data.videoUri != '')
        && !(request.resource.data.videoUri != '' && request.resource.data.imageUri != '')
        && validPoll(request.resource.data.poll)
        && request.resource.data.createdAt == request.time;
      allow delete: if owner(resource.data.creatorId);
      match /comments/{commentId} {
        allow read: if signedIn() && exists(/databases/$(database)/documents/posts/$(postId));
        allow create: if hasProfile() && exists(/databases/$(database)/documents/posts/$(postId))
          && request.resource.data.keys().hasAll(['authorId', 'author', 'text', 'createdAt'])
          && request.resource.data.keys().hasOnly(['authorId', 'author', 'text', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.author == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.handle
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow delete: if owner(resource.data.authorId);
      }
    }
    match /stories/{storyId} {
      allow read: if signedIn() && (resource.data.creatorId == request.auth.uid
        || exists(/databases/$(database)/documents/accounts/$(request.auth.uid)/following/$(resource.data.creatorId)));
      allow create: if hasProfile() && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.keys().hasAll(['creatorId', 'text', 'imageUri', 'videoUri', 'createdAt'])
        && request.resource.data.keys().hasOnly(['creatorId', 'text', 'imageUri', 'videoUri', 'createdAt'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 180
        && cloudMedia(request.resource.data.imageUri) && cloudMedia(request.resource.data.videoUri)
        && ((request.resource.data.imageUri != '' && request.resource.data.videoUri == '')
          || (request.resource.data.videoUri != '' && request.resource.data.imageUri == ''))
        && request.resource.data.createdAt == request.time;
      allow delete: if owner(resource.data.creatorId);
    }
    match /reactions/{reactionId} {
      allow read: if signedIn();
      function validReaction() {
        let r = request.resource.data;
        return hasProfile() && r.keys().hasAll(['postId', 'userId', 'liked', 'reposted', 'vote'])
          && r.keys().hasOnly(['postId', 'userId', 'liked', 'reposted', 'vote'])
          && r.userId == request.auth.uid && reactionId == r.postId + '_' + request.auth.uid
          && exists(/databases/$(database)/documents/posts/$(r.postId))
          && r.liked is bool && r.reposted is bool && r.vote is int && r.vote >= -1 && r.vote <= 1
          && (r.vote == -1 || get(/databases/$(database)/documents/posts/$(r.postId)).data.poll != null);
      }
      allow create: if validReaction();
      allow update: if validReaction() && owner(resource.data.userId)
        && (resource.data.vote == -1 || request.resource.data.vote == resource.data.vote);
    }
    match /accounts/{uid}/saved/{postId} {
      allow read, delete: if owner(uid);
      allow create: if owner(uid) && hasProfile() && exists(/databases/$(database)/documents/posts/$(postId))
        && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
    }
    match /accounts/{uid}/following/{target} {
      allow read: if signedIn();
      allow delete: if owner(uid);
      allow create: if owner(uid) && hasProfile() && uid != target
        && exists(/databases/$(database)/documents/profiles/$(target))
        && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
    }
    // Following relationships are public to signed-in users. The recursive
    // read also allows collection-group queries over the existing path schema.
    // Saved items and all other account collections keep their private rules.
    match /{path=**}/following/{target} {
      allow read: if signedIn();
    }
    match /accounts/{uid}/notifications/{notificationId} {
      allow read, delete: if owner(uid);
      function reactionStarted(postId, field) {
        let path = /databases/$(database)/documents/reactions/$(postId + '_' + request.auth.uid);
        return getAfter(path).data[field] == true
          && (!exists(path) || get(path).data[field] == false);
      }
      function commentStarted(n) {
        let commentPath = /databases/$(database)/documents/posts/$(n.postId)/comments/$(n.commentId);
        return !exists(commentPath) && getAfter(commentPath).data.authorId == request.auth.uid
          && getAfter(commentPath).data.createdAt == request.time;
      }
      function linkedEvent(n) {
        let postPath = /databases/$(database)/documents/posts/$(n.postId);
        return n.postId.matches('[a-zA-Z0-9_-]{1,128}')
          && get(postPath).data.creatorId == uid
          && ((n.type == 'like' && n.commentId == '' && notificationId == 'like_' + n.postId + '_' + request.auth.uid && reactionStarted(n.postId, 'liked'))
            || (n.type == 'repost' && n.commentId == '' && notificationId == 'repost_' + n.postId + '_' + request.auth.uid && reactionStarted(n.postId, 'reposted'))
            || (n.type == 'comment' && n.commentId.matches('[a-zA-Z0-9_-]{1,128}')
              && notificationId == 'comment_' + n.commentId
              && commentStarted(n)));
      }
      function validNotification() {
        let n = request.resource.data;
        let followPath = /databases/$(database)/documents/accounts/$(request.auth.uid)/following/$(uid);
        return hasProfile() && uid != request.auth.uid
          && n.keys().hasAll(['actorId', 'type', 'postId', 'commentId', 'createdAt'])
          && n.keys().hasOnly(['actorId', 'type', 'postId', 'commentId', 'createdAt'])
          && n.actorId == request.auth.uid && n.createdAt == request.time
          && n.type in ['follow', 'like', 'comment', 'repost'] && n.postId is string && n.commentId is string
          && ((n.type == 'follow' && n.postId == '' && n.commentId == '' && notificationId == 'follow_' + request.auth.uid
              && !exists(followPath) && existsAfter(followPath))
            || (n.type != 'follow' && linkedEvent(n)));
      }
      // A notification is valid only alongside a real new interaction in the same atomic write.
      allow create, update: if signedIn() && validNotification();
    }
    match /accounts/{uid}/preferences/notifications {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['readThrough'])
        && request.resource.data.readThrough is timestamp && request.resource.data.readThrough <= request.time
        && (!exists(/databases/$(database)/documents/accounts/$(uid)/preferences/notifications)
          || request.resource.data.readThrough >= resource.data.readThrough);
    }
    // Everything else is denied, including client writes to admin content.
  }
}
